# ---------------------------------------------------------------------------
# Copia questo file in `.env` e compilalo. `.env` e' git-ignorato: non finira'
# mai nel repository. Non incollare questi valori in una chat.
# ---------------------------------------------------------------------------

# OBBLIGATORIO. System User token del Business Manager, con ads_read
# (sola lettura) e ads_management (per modificare stato e budget).
META_ACCESS_TOKEN=

# Versione della Graph API. Lasciala vuota per usare il default del codice.
# Se Meta segnala che la versione e' deprecata, alza questo numero.
META_API_VERSION=

# --- Guardrail: sono la tua rete di sicurezza, non toglierli ---------------

# Solo questi ad account sono raggiungibili. Fortemente consigliato:
# evita che un id sbagliato vada a toccare l'account di qualcun altro.
# Esempio: act_123456789,act_987654321
META_ALLOWED_ACCOUNT_IDS=

# true = nessuna modifica possibile, solo lettura. Utile per i primi giorni.
META_READ_ONLY=false

# Tetti di budget in unita' intere di valuta (50 = 50 EUR, non centesimi).
# Una richiesta oltre il tetto viene rifiutata senza nemmeno chiamare Meta,
# e l'unico modo per superarla e' modificare questo file: il modello non puo'.
META_MAX_DAILY_BUDGET=50
META_MAX_LIFETIME_BUDGET=1000

# File su cui registrare ogni scrittura, una riga JSON per modifica.
# Se vuoto, l'audit va sui log del processo.
MCP_ADS_AUDIT_LOG=./meta.audit.jsonl

# --- Solo per la modalita' HTTP (server online) ----------------------------

# Password dell'endpoint MCP: senza di essa il server HTTP non parte.
# Generala con: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Porta e percorso dell'endpoint HTTP (default 8787 e /mcp).
PORT=8787
MCP_PATH=/mcp
