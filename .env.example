# ---------------------------------------------------------------------------
# Variabili d'ambiente del sito PROJECTUNE
#
# Copiare questo file in `.env` per lo sviluppo locale e impostare gli stessi
# nomi nel pannello del provider di hosting per la produzione.
# `.env` è escluso da git: NON committare mai valori reali.
# Tutti i valori qui sotto sono fittizi.
# ---------------------------------------------------------------------------

# --- Servizio di posta transazionale ---------------------------------------
# Nomi generici: cambiando fornitore non si rinominano le variabili su
# tutti gli ambienti. L'adattatore accetta anche i nomi storici del
# fornitore attuale (MAILJET_API_KEY / MAILJET_SECRET_KEY) come ricaduta.
MAILER_API_KEY=00000000000000000000000000000000
MAILER_API_SECRET=11111111111111111111111111111111

# Nomi alternativi accettati, equivalenti ai due precedenti.
# MAILJET_API_KEY=00000000000000000000000000000000
# MAILJET_SECRET_KEY=11111111111111111111111111111111

# --- Indirizzi del modulo contatti -----------------------------------------
# Dove arrivano le notifiche delle nuove richieste.
CONTACT_TO_EMAIL=info@esempio.it
# Mittente delle email: deve essere un indirizzo verificato presso il
# fornitore di posta, altrimenti l'invio viene rifiutato.
CONTACT_FROM_EMAIL=no-reply@esempio.it
CONTACT_FROM_NAME=PROJECTUNE

# --- Servizio antispam (Cloudflare Turnstile) ------------------------------
# Chiave segreta, usata solo lato server dalla funzione.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000
# Chiave pubblica, inclusa nella pagina: il prefisso PUBLIC_ è richiesto da
# Astro per esporla al browser. Se è vuota il widget non viene mostrato e il
# modulo resta protetto da honeypot e limite di frequenza.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Linea grafica ---------------------------------------------------------
# Quale tema costruire: 1 = officina (fondo scuro metallico, di serie),
# 2 = tavola (il sito disegnato su un foglio da disegno tecnico).
# Si può anche passare al volo: `npm run build:tema2`.
# PUBLIC_TEMA=1
