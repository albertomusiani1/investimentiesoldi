{
  "name": "projectune",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sito vetrina PROJECTUNE - progettazione meccanica, montaggi e revisioni",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:pages": "node scripts/check-pages.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "linkinator dist --recurse --skip \"^https://www\\.projectune\\.it\"",
    "logo": "node scripts/genera-logo.mjs",
    "immagini:social": "node scripts/genera-immagini-social.mjs",
    "immagini:progetti": "node scripts/genera-immagini-progetti.mjs",
    "trame": "node scripts/genera-trame.mjs",
    "disegni": "node scripts/genera-disegni.mjs",
    "video": "node scripts/genera-video-hero.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.9",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
