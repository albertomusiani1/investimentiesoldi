---
import BaseLayout from '../layouts/BaseLayout.astro';
import EroeVideo from '../components/EroeVideo.astro';
import SchedaProgetto from '../components/SchedaProgetto.astro';
import Clienti from '../components/Clienti.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n';
import { servizi } from '../lib/servizi';
import { schemaAttivita } from '../lib/schema';

const site = Astro.site ?? new URL('http://localhost:4321');

const progetti = await getCollection('progetti');
const inEvidenza = progetti
  .filter((p) => p.data.inEvidenza)
  .sort((a, b) => (a.data.ordine ?? 99) - (b.data.ordine ?? 99))
  .slice(0, 3);

/** CONTENUTO — Cifre di sintesi mostrate in home. Solo dati verificabili. */
const numeri = [
  { cifra: '2025', etichetta: 'Anno in cui abbiamo iniziato' },
  { cifra: '10', etichetta: 'Anni di progettazione nel farmaceutico' },
  { cifra: '500', etichetta: 'Metri quadri di officina attrezzata' },
  { cifra: '7', etichetta: 'Aziende che ci hanno dato fiducia' },
];
---

<BaseLayout
  titolo={t('home.metaTitolo')}
  descrizione={t('home.metaDescrizione')}
  jsonLd={[schemaAttivita(site)]}
>
  <EroeVideo ancoraSuccessiva="che-cosa-facciamo" />

  <section class="sezione" id="che-cosa-facciamo" aria-labelledby="titolo-servizi">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-servizi">{t('home.serviziTitolo')}</h2>
        <p>{t('home.serviziSottotitolo')}</p>
      </div>
      <ul class="griglia griglia--2 elenco-servizi">
        {
          servizi.map((servizio) => (
            <li class="scheda scheda--collegata">
              <div class="scheda__corpo">
                <h3 class="scheda__titolo">
                  <a href={`/servizi#${servizio.id}`}>{servizio.titolo}</a>
                </h3>
                <p class="scheda__testo">{servizio.sommario}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione sezione--scura" aria-labelledby="titolo-numeri">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-numeri">{t('home.numeriTitolo')}</h2>
      </div>
      <ul class="numeri">
        {
          numeri.map((n) => (
            <li>
              <span class="numero__cifra">{n.cifra}</span>
              <span class="numero__etichetta">{n.etichetta}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione sezione--alt" aria-labelledby="titolo-progetti">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-progetti">{t('home.progettiTitolo')}</h2>
        <p>{t('home.progettiSottotitolo')}</p>
      </div>
      <ul class="griglia griglia--2 griglia--3">
        {
          inEvidenza.map((progetto, indice) => (
            <li>
              <SchedaProgetto progetto={progetto} prioritaria={indice === 0} />
            </li>
          ))
        }
      </ul>
      <div class="gruppo-bottoni">
        <a class="bottone bottone--secondario" href="/progetti">{t('azioni.vediProgetti')}</a>
      </div>
    </div>
  </section>

  <section class="sezione" aria-labelledby="titolo-cta">
    <div class="contenitore contenitore--stretto centrato">
      <h2 id="titolo-cta">{t('home.ctaTitolo')}</h2>
      <p class="cta__testo">{t('home.ctaTesto')}</p>
      <div class="gruppo-bottoni gruppo-bottoni--centrato">
        <a class="bottone bottone--primario" href="/contatti">{t('azioni.vaiAiContatti')}</a>
      </div>
    </div>
  </section>

  <Clienti />
</BaseLayout>

<style>
  .elenco-servizi {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cta__testo {
    margin-top: var(--space-4);
    margin-inline: auto;
    max-width: var(--misura);
    color: var(--colore-testo-tenue);
    font-size: var(--testo-md);
  }

  .gruppo-bottoni--centrato {
    justify-content: center;
  }

  .griglia > li {
    display: flex;
  }

  .griglia > li > :global(*) {
    width: 100%;
  }

</style>
