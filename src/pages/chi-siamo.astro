---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { azienda, referenti } from '../lib/azienda';

/** CONTENUTO — Come siamo arrivati fin qui. */
const storia = [
  {
    anno: 'Prima',
    titolo: 'Dieci anni di macchine automatiche',
    testo:
      "Davide passa dieci anni a progettare macchine automatiche per il settore farmaceutico, e nel frattempo mette le mani anche su accumulatori oleodinamici e macchinari per fonderia. Simone monta gruppi meccanici in piccola e media serie per il packaging, e impara a revisionare pompe idrauliche e pompe per vuoto.",
  },
  {
    anno: '2025',
    titolo: 'Nasce PROJECTUNE',
    testo:
      "Decidiamo di provarci per conto nostro: mettere insieme la progettazione e il montaggio, che nelle aziende stanno in due reparti diversi e qui stanno nella stessa stanza. L'attività nasce a Castel Maggiore, dove siamo nati e cresciuti anche noi.",
  },
  {
    anno: 'Oggi',
    titolo: "Un'officina condivisa e una fila di clienti",
    testo:
      "Lavoriamo dai clienti oppure nella nostra sede, cinquecento metri quadri condivisi con AZ Vacuum, che è insieme partner e cliente. Il modo di lavorare ci ha fatto conoscere in più ambiti, e con la maggior parte dei clienti il rapporto si è consolidato.",
  },
];

/** CONTENUTO — Il nostro credo. */
const valori = [
  {
    titolo: 'Una realtà giovane e dinamica',
    testo:
      "PROJECTUNE nasce dalla voglia di intraprendere un percorso nostro e di crescere: come persone prima ancora che come azienda. È il motivo per cui esistiamo, non una frase da mettere in fondo alla pagina.",
  },
  {
    titolo: 'Lavoro che resta sul territorio',
    testo:
      'Vogliamo costruire qualcosa che porti lavoro nella comunità in cui siamo cresciuti. Castel Maggiore non è un indirizzo scelto per comodità: è casa nostra.',
  },
  {
    titolo: 'Serietà, che si vede dopo',
    testo:
      'Un montaggio o un disegno fatti bene si riconoscono a distanza di mesi, quando la macchina lavora e nessuno deve tornarci sopra. È così che ci siamo fatti conoscere, ed è così che intendiamo continuare.',
  },
  {
    titolo: 'Due interlocutori, non un centralino',
    testo:
      'Siamo in due: chi risponde al telefono è la stessa persona che farà il lavoro. Non c’è nessuno a cui passare la pratica, e questo tiene le cose semplici.',
  },
];

/** CONTENUTO — Le due persone dell'azienda. */
const persone = [
  {
    nome: referenti[0]!.nome,
    ruolo: referenti[0]!.ruolo,
    testo:
      "Progettista meccanico con dieci anni di esperienza su macchine automatiche per il farmaceutico, e incursioni negli accumulatori oleodinamici e nei macchinari per fonderia.",
  },
  {
    nome: referenti[1]!.nome,
    ruolo: referenti[1]!.ruolo,
    testo:
      'Montatore meccanico: piccole e medie serie per macchine da packaging, revisione e manutenzione di pompe idrauliche e per vuoto, montaggio di componenti per accumulatori.',
  },
];

/** CONTENUTO — L'officina. */
const officina = [
  {
    voce: `${azienda.superficieOfficina} m²`,
    testo: 'Officina attrezzata a Castel Maggiore, condivisa con AZ Vacuum, partner e cliente.',
  },
  {
    voce: 'Sale di test',
    testo: "Prove sul vuoto per il settore farmaceutico e alimentare, nella stessa sede.",
  },
  {
    voce: 'Montaggio e prova',
    testo: 'Macchinari automatici montati e provati prima di partire per lo stabilimento di destinazione.',
  },
  {
    voce: 'Oppure da voi',
    testo: 'Siamo attrezzati per lavorare direttamente presso il cliente, quando conviene stare sulla macchina.',
  },
];

const iniziali = (nome: string) =>
  nome
    .split(' ')
    .map((parte) => parte.charAt(0))
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<BaseLayout
  titolo={t('chiSiamo.metaTitolo')}
  descrizione={t('chiSiamo.metaDescrizione')}
  briciole={[{ etichetta: t('nav.chiSiamo') }]}
>
  <section class="sezione">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h1>{t('chiSiamo.titolo')}</h1>
        <p>{t('chiSiamo.introduzione')}</p>
      </div>
    </div>
  </section>

  <section class="sezione sezione--alt" aria-labelledby="titolo-storia">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-storia">{t('chiSiamo.storiaTitolo')}</h2>
      </div>
      <ol class="storia">
        {
          storia.map((tappa) => (
            <li class="tappa">
              <span class="tappa__anno">{tappa.anno}</span>
              <div class="tappa__corpo">
                <h3 class="tappa__titolo">{tappa.titolo}</h3>
                <p>{tappa.testo}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sezione" aria-labelledby="titolo-team">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-team">{t('chiSiamo.teamTitolo')}</h2>
      </div>
      <ul class="griglia griglia--2 elenco-piatto">
        {
          persone.map((persona) => (
            <li class="persona">
              <svg
                class="persona__monogramma"
                width="72"
                height="72"
                viewBox="0 0 72 72"
                role="img"
                aria-hidden="true"
                focusable="false"
              >
                <rect width="72" height="72" rx="6" fill="#303435" />
                <text
                  x="36"
                  y="46"
                  text-anchor="middle"
                  font-family="Arial, Helvetica, sans-serif"
                  font-size="26"
                  font-weight="bold"
                  fill="#6fbbe6"
                >
                  {iniziali(persona.nome)}
                </text>
              </svg>
              <div>
                <h3 class="persona__nome">{persona.nome}</h3>
                <p class="persona__ruolo">{persona.ruolo}</p>
                <p class="persona__testo">{persona.testo}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione sezione--alt" aria-labelledby="titolo-valori">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-valori">{t('chiSiamo.valoriTitolo')}</h2>
      </div>
      <ul class="griglia griglia--2 elenco-piatto">
        {
          valori.map((valore) => (
            <li class="scheda">
              <div class="scheda__corpo">
                <h3 class="scheda__titolo">{valore.titolo}</h3>
                <p class="scheda__testo">{valore.testo}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione" aria-labelledby="titolo-sede">
    <div class="contenitore">
      <div class="intestazione-sezione">
        <h2 id="titolo-sede">{t('chiSiamo.sedeTitolo')}</h2>
      </div>
      <dl class="prosa officina">
        {
          officina.map((riga) => (
            <>
              <dt>{riga.voce}</dt>
              <dd>{riga.testo}</dd>
            </>
          ))
        }
      </dl>
      <div class="gruppo-bottoni">
        <a class="bottone bottone--primario" href="/contatti">{t('azioni.vaiAiContatti')}</a>
      </div>
      <p class="nota">
        {`${azienda.nomeLegale} · ${t('footer.partitaIva')} ${azienda.datiSocietari.partitaIva}`}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .storia {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tappa {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--colore-bordo);
  }

  .tappa__anno {
    font-family: var(--font-display);
    font-size: var(--testo-md);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colore-accento);
  }

  .tappa__titolo {
    font-size: var(--testo-md);
  }

  .tappa__corpo p {
    margin-top: var(--space-2);
    max-width: var(--misura);
    color: var(--colore-testo-tenue);
  }

  .elenco-piatto {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .persona {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .persona__monogramma {
    flex: none;
    border-radius: var(--raggio);
  }

  .persona__nome {
    font-size: var(--testo-md);
  }

  .persona__ruolo {
    margin-top: var(--space-1);
    color: var(--colore-accento);
    font-size: var(--testo-xs);
    font-weight: 600;
    letter-spacing: var(--tracciatura-etichetta);
    text-transform: uppercase;
  }

  .persona__testo {
    margin-top: var(--space-3);
    color: var(--colore-testo-tenue);
    font-size: var(--testo-sm);
  }

  .officina {
    margin-top: 0;
  }

  .nota {
    margin-top: var(--space-6);
    color: var(--colore-testo-tenue);
    font-size: var(--testo-sm);
  }

  @media (min-width: 64em) {
    .tappa {
      grid-template-columns: 8rem 1fr;
      gap: var(--space-5);
      align-items: baseline;
    }
  }
</style>
