---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntestazioneSezione from '../components/IntestazioneSezione.astro';
import SchedaProgetto from '../components/SchedaProgetto.astro';
import PercorsoLavori from '../components/PercorsoLavori.astro';
import { getCollection } from 'astro:content';
import { CATEGORIE_PROGETTO } from '../content.config';
import { t } from '../i18n';

const progetti = (await getCollection('progetti')).sort((a, b) => {
  const ordineA = a.data.ordine ?? Number.MAX_SAFE_INTEGER;
  const ordineB = b.data.ordine ?? Number.MAX_SAFE_INTEGER;
  if (ordineA !== ordineB) return ordineA - ordineB;
  return b.data.data.getTime() - a.data.data.getTime();
});

/** Solo le categorie che hanno almeno un progetto pubblicato. */
const categorieUsate = CATEGORIE_PROGETTO.filter((categoria) =>
  progetti.some((progetto) => progetto.data.categoria === categoria)
);

/**
 * I disegni di tutti i lavori pubblicati, riuniti nell'ultima tappa del
 * percorso. Il limite di otto non è arbitrario: tante sono le regole CSS
 * che pilotano i pannelli del visualizzatore senza JavaScript.
 */
const MASSIMO_DISEGNI = 8;
const disegni = progetti.flatMap((progetto) => progetto.data.disegni ?? []).slice(0, MASSIMO_DISEGNI);

/** Identificatore CSS/HTML sicuro per una categoria. */
const idCategoria = (categoria: string) =>
  `categoria-${categoria.toLowerCase().normalize('NFD').replace(/[^a-z]/g, '')}`;
---

<BaseLayout
  titolo={t('progetti.metaTitolo')}
  descrizione={t('progetti.metaDescrizione')}
  briciole={[{ etichetta: t('nav.progetti') }]}
>
  <section class="sezione">
    <div class="contenitore">
      <IntestazioneSezione
        indice="01"
        etichetta={t('nav.progetti')}
        titolo={t('progetti.titolo')}
        testo={t('progetti.introduzione')}
        id="titolo-progetti"
        principale
      />

      {
        progetti.length === 0 ? (
          <p>{t('progetti.nessunProgetto')}</p>
        ) : (
          <div class="filtro-progetti">
            <fieldset class="filtro">
              <legend class="filtro__titolo">{t('comune.filtraPerCategoria')}</legend>
              <div class="filtro__voci">
                <input
                  class="solo-screen-reader filtro__radio"
                  type="radio"
                  name="categoria"
                  id="categoria-tutte"
                  value="tutte"
                  checked
                />
                <label class="filtro__etichetta" for="categoria-tutte">
                  {t('comune.tutteLeCategorie')}
                </label>
                {categorieUsate.map((categoria) => (
                  <>
                    <input
                      class="solo-screen-reader filtro__radio"
                      type="radio"
                      name="categoria"
                      id={idCategoria(categoria)}
                      value={categoria}
                    />
                    <label class="filtro__etichetta" for={idCategoria(categoria)}>
                      {categoria}
                    </label>
                  </>
                ))}
              </div>
            </fieldset>

            {/* Titolo di livello 2 fra l'h1 della pagina e gli h3 delle
                schede: senza, la gerarchia salta un gradino e chi naviga per
                intestazioni non trova l'elenco. Non serve vederlo. */}
            <h2 class="solo-screen-reader">{t('progetti.elencoTitolo')}</h2>

            <ul class="griglia griglia--2 griglia--3 elenco-progetti">
              {progetti.map((progetto, indice) => (
                <li class="rivela" data-categoria={progetto.data.categoria}>
                  <SchedaProgetto progetto={progetto} prioritaria={indice < 2} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <PercorsoLavori disegni={disegni} indice="02" />
</BaseLayout>

<style>
  /* Il filtro è interamente HTML + CSS: i radio pilotano la visibilità
     delle schede tramite :has(), senza una riga di JavaScript. */
  .filtro {
    margin: 0 0 var(--space-6);
    padding: 0;
    border: 0;
  }

  .filtro__titolo {
    padding: 0;
    margin-bottom: var(--space-3);
    color: var(--colore-testo-tenue);
    font-size: var(--testo-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .filtro__voci {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filtro__etichetta {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background-color: var(--colore-superficie);
    border: 1px solid var(--colore-bordo-forte);
    border-radius: 999px;
    color: var(--colore-testo);
    font-family: var(--font-mono);
    font-size: var(--testo-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--transizione),
      border-color var(--transizione),
      color var(--transizione);
  }

  .filtro__etichetta:hover {
    border-color: var(--colore-accento);
    color: var(--colore-accento);
  }

  .filtro__radio:checked + .filtro__etichetta {
    background-color: var(--marchio-blu);
    border-color: var(--marchio-blu);
    color: var(--colore-su-accento);
  }

  .filtro__radio:focus-visible + .filtro__etichetta {
    outline: 3px solid var(--colore-accento);
    outline-offset: 2px;
  }

  .elenco-progetti {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .elenco-progetti > li {
    display: flex;
  }

  .elenco-progetti > li > :global(*) {
    width: 100%;
  }

  .filtro-progetti:has(#categoria-progettazione:checked)
    .elenco-progetti
    > li:not([data-categoria='Progettazione']),
  .filtro-progetti:has(#categoria-produzione:checked)
    .elenco-progetti
    > li:not([data-categoria='Produzione']),
  .filtro-progetti:has(#categoria-validazione:checked)
    .elenco-progetti
    > li:not([data-categoria='Validazione']),
  .filtro-progetti:has(#categoria-elettrificazione:checked)
    .elenco-progetti
    > li:not([data-categoria='Elettrificazione']) {
    display: none;
  }
</style>
