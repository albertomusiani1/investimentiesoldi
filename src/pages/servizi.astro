---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntestazioneSezione from '../components/IntestazioneSezione.astro';
import IconaServizio from '../components/IconaServizio.astro';
import { t } from '../i18n';
import { servizi } from '../lib/servizi';
---

<BaseLayout
  titolo={t('servizi.metaTitolo')}
  descrizione={t('servizi.metaDescrizione')}
  briciole={[{ etichetta: t('nav.servizi') }]}
>
  <section class="sezione">
    <div class="contenitore">
      <IntestazioneSezione
        indice="01"
        etichetta={t('nav.servizi')}
        titolo={t('servizi.titolo')}
        testo={t('servizi.introduzione')}
        id="titolo-servizi"
        principale
      />

      <div class="elenco-servizi">
        {
          servizi.map((servizio, indice) => (
            <article class="voce rivela" id={servizio.id}>
              <div class="voce__lato">
                <span class="esagono voce__icona" aria-hidden="true">
                  <IconaServizio nome={servizio.icona} />
                </span>
                <span class="voce__numero" aria-hidden="true">
                  {String(indice + 1).padStart(2, '0')}
                </span>
              </div>
              <div class="voce__corpo">
                <h2>{servizio.titolo}</h2>
                {servizio.descrizione.map((paragrafo) => (
                  <p class="voce__paragrafo">{paragrafo}</p>
                ))}
                <p class="etichetta-tecnica voce__sottotitolo">{t('servizi.cosaComprende')}</p>
                <ul class="voce__punti">
                  {servizio.punti.map((punto) => (
                    <li>{punto}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sezione trama" aria-labelledby="titolo-cta-servizi">
    <div class="contenitore contenitore--stretto">
      <h2 id="titolo-cta-servizi">{t('servizi.ctaTitolo')}</h2>
      <p class="cta__testo">{t('servizi.ctaTesto')}</p>
      <div class="gruppo-bottoni">
        <a class="bottone bottone--secondario" href="/contatti">{t('azioni.vaiAiContatti')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .elenco-servizi {
    display: grid;
    gap: var(--space-7);
  }

  .voce {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--colore-bordo);
    scroll-margin-top: calc(var(--altezza-intestazione) + var(--space-5));
  }

  .voce__lato {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .voce__icona {
    width: 3.25rem;
    color: var(--colore-accento);
    background-color: rgb(48 147 201 / 14%);
  }

  .voce__icona svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .voce__numero {
    color: var(--colore-bordo-forte);
    font-family: var(--font-mono);
    font-size: var(--testo-lg);
    letter-spacing: 0.04em;
  }

  .voce__corpo {
    max-width: var(--misura);
  }

  .voce__paragrafo {
    margin-top: var(--space-4);
    color: var(--colore-testo-tenue);
  }

  .voce__sottotitolo {
    margin-top: var(--space-6);
  }

  /* Punti elenco con l'esagono al posto del pallino. */
  .voce__punti {
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .voce__punti li {
    position: relative;
    padding-left: var(--space-5);
  }

  .voce__punti li + li {
    margin-top: var(--space-3);
  }

  .voce__punti li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.5rem;
    height: calc(0.5rem / var(--esagono-proporzione));
    background-color: var(--marchio-blu);
    clip-path: var(--esagono);
  }

  .cta__testo {
    margin-top: var(--space-4);
    max-width: var(--misura);
  }

  @media (min-width: 64em) {
    .voce {
      grid-template-columns: 9rem 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    .voce__lato {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
