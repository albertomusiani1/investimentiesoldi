---
/**
 * Intestazione del sito.
 *
 * Non è più una barra staccata appoggiata sopra la pagina: sta **dentro** il
 * hero. È fissa in cima, trasparente, e sopra il video si vedono solo il
 * marchio e le voci — nessun rettangolo, nessun filetto che tagli in due la
 * schermata di apertura.
 *
 * Il fondo compare da solo appena si comincia a scorrere: è
 * un'animazione legata allo scorrimento (`animation-timeline: scroll()`),
 * quindi nessun JavaScript e nessun ascoltatore di eventi. Dove non è
 * supportata resta la barra semitrasparente di sempre, dichiarata come
 * ricaduta.
 */
import Logo from './Logo.astro';
import { t } from '../i18n';

const percorsoCorrente = Astro.url.pathname.replace(/\/$/, '') || '/';

const voci = [
  { href: '/', etichetta: t('nav.home') },
  { href: '/servizi', etichetta: t('nav.servizi') },
  { href: '/progetti', etichetta: t('nav.progetti') },
  { href: '/chi-siamo', etichetta: t('nav.chiSiamo') },
  { href: '/contatti', etichetta: t('nav.contatti') },
];

const isAttiva = (href: string) =>
  href === '/' ? percorsoCorrente === '/' : percorsoCorrente.startsWith(href);
---

<header class="intestazione">
  <div class="contenitore intestazione__interno">
    <a class="intestazione__marchio" href="/">
      <Logo variante="orizzontale" />
      <span class="solo-screen-reader">— {t('nav.home')}</span>
    </a>

    <nav class="intestazione__nav" aria-label={t('nav.etichettaPrincipale')}>
      <ul>
        {
          voci.map((voce) => (
            <li>
              <a
                href={voce.href}
                aria-current={isAttiva(voce.href) ? 'page' : undefined}
                class:list={['intestazione__link', { 'intestazione__link--attivo': isAttiva(voce.href) }]}
              >
                <span class="scorri-testo" data-taglio-voluto>
                  <span data-testo={voce.etichetta}>{voce.etichetta}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .intestazione {
    /* Fissa, non «sticky»: la pagina le scorre sotto e il hero comincia da
       zero, dietro di lei. È questo che tiene insieme barra e apertura. */
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 20;
    background-color: transparent;
    color: var(--colore-testo-inverso);
    /* Resta ferma durante la transizione fra una pagina e l'altra: il
       contenuto cambia, il menu no. */
    view-transition-name: intestazione;
  }

  /* Il fondo che compare scorrendo. Due dichiarazioni separate:
     `animation-timeline` non va mai accanto alla scorciatoia `animation`,
     perché il minificatore le fonde in una regola che nessun browser
     accetta e l'animazione sparisce senza dire niente. */
  @supports (animation-timeline: scroll()) {
    .intestazione {
      animation-name: barra-solida;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll();
      animation-range: 0 6rem;
    }
  }

  /* Dove le animazioni da scorrimento non ci sono (o sono state disattivate
     dal sistema) la barra è sempre velata: meglio un fondo di troppo che un
     menu illeggibile sopra una fotografia chiara. */
  @supports not (animation-timeline: scroll()) {
    .intestazione {
      background-color: rgb(14 21 24 / 82%);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      box-shadow: 0 1px 0 0 rgb(255 255 255 / 8%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intestazione {
      background-color: rgb(14 21 24 / 88%);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
    }
  }

  @keyframes barra-solida {
    to {
      background-color: rgb(14 21 24 / 86%);
      backdrop-filter: blur(16px) saturate(150%);
      -webkit-backdrop-filter: blur(16px) saturate(150%);
      box-shadow: 0 1px 0 0 rgb(255 255 255 / 9%), 0 10px 30px rgb(0 0 0 / 30%);
    }
  }

  .intestazione__interno {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .intestazione__marchio {
    align-self: flex-start;
    color: var(--colore-testo-inverso);
    text-decoration: none;
  }

  .intestazione__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Le voci sono monospaziate e minuscole: la stessa lingua delle etichette
     tecniche del sito. Il segno della pagina in cui ci si trova non è più
     una sottolineatura ma un esagono, che è la forma del marchio. */
  .intestazione__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-1);
    color: var(--colore-testo-inverso-tenue);
    font-family: var(--font-mono);
    font-size: var(--testo-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--transizione);
  }

  .intestazione__link::before {
    content: '';
    flex: none;
    width: 0.4375rem;
    height: calc(0.4375rem / var(--esagono-proporzione));
    background-color: currentcolor;
    clip-path: var(--esagono);
    opacity: 0;
    transition: opacity var(--transizione);
  }

  .intestazione__link:hover {
    color: var(--colore-accento);
  }

  .intestazione__link:hover::before {
    opacity: 0.6;
  }

  .intestazione__link--attivo {
    color: var(--colore-testo-inverso);
  }

  .intestazione__link--attivo::before {
    background-color: var(--marchio-blu);
    opacity: 1;
  }

  @media (min-width: 40em) {
    .intestazione__interno {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
      padding-block: var(--space-4);
    }

    .intestazione__nav ul {
      gap: var(--space-5);
    }
  }

  @media (min-width: 64em) {
    .intestazione__nav ul {
      gap: var(--space-6);
    }
  }
</style>
