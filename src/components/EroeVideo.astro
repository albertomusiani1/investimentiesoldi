---
/**
 * Hero della home: un video astratto a schermo intero, il titolo e una
 * didascalia. Nient'altro.
 *
 * La scelta di togliere occhiello, bottoni e riga di dati è deliberata: su
 * una schermata di apertura ogni elemento in più toglie forza al titolo. Le
 * due chiamate all'azione sono rimaste in fondo alla pagina, dove hanno
 * senso; qui c'è solo quello che il visitatore deve leggere per primo.
 *
 * Come si comporta:
 *  - senza JavaScript resta il fermo immagine (il poster), che è anche
 *    l'elemento più grande della pagina e quindi quello che decide la
 *    velocità percepita: per questo è marcato `fetchpriority="high"`;
 *  - con JavaScript il video parte quando il hero è in vista e si ferma
 *    quando lo si è scorso via, per non consumare batteria a vuoto;
 *  - se il sistema chiede meno animazioni (`prefers-reduced-motion`) il
 *    video non parte affatto.
 *
 * Il video non è contenuto informativo: è decorazione. Per questo è
 * `aria-hidden` e il poster ha `alt` vuoto — chi usa un lettore di schermo
 * sente il titolo, non la descrizione di un'animazione.
 *
 * Sfocatura e velo non sono un ripiego: il filmato deve **stare dietro** al
 * titolo, non contendergli l'attenzione. Sfocato, il movimento si legge
 * ancora ma nessuna linea entra in concorrenza con il testo.
 */
import { t } from '../i18n';

export interface Props {
  /** Ancora della prima sezione sotto il hero, per il collegamento "Scorri". */
  ancoraSuccessiva: string;
}

const { ancoraSuccessiva } = Astro.props;
---

<section class="eroe" data-eroe>
  <!-- `data-taglio-voluto` sta qui e non sulla sezione: il filmato è
       ingrandito dell'8 % perché la sfocatura non lasci una cornice sfumata
       lungo i bordi, e quel margine in più va tagliato di proposito. Marcando
       la sezione intera, il controllo del responsive smetterebbe di guardare
       anche il titolo e la didascalia, che invece devono starci. -->
  <div class="eroe__sfondo" aria-hidden="true" data-taglio-voluto>
    <picture class="eroe__poster">
      <source
        type="image/webp"
        srcset="/img/hero-poster-900.webp 900w, /img/hero-poster-1600.webp 1600w"
        sizes="100vw"
      />
      <img
        src="/img/hero-poster.jpg"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      class="eroe__video"
      data-eroe-video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="eroe__favo"></div>
    <div class="eroe__velo"></div>
  </div>

  <div class="contenitore eroe__contenuto">
    <h1 class="eroe__titolo">
      {t('home.heroTitolo')}
      <span class="eroe__titolo-accento">{t('home.heroTitoloAccento')}</span>
    </h1>
    <p class="eroe__didascalia">{t('home.heroTesto')}</p>
  </div>

  <a class="eroe__scorri" href={`#${ancoraSuccessiva}`}>
    <span class="solo-screen-reader">{t('home.heroScorri')}</span>
    <span class="eroe__scorri-filo" aria-hidden="true"></span>
  </a>
</section>

<script>
  // Il codice sta in un modulo separato: così Astro lo emette come file
  // esterno e la Content-Security-Policy può restare senza 'unsafe-inline'.
  import '../scripts/eroe-video.ts';
</script>
